# Ключи с Gate.io -> https://www.gate.io/myaccount/api_key_manage
GATE_API_KEY=твой_api_key_сюда
GATE_API_SECRET=твой_secret_сюда

# Секрет для вебхука чтобы никто чужой не дергал твоего бота
# Придумай любой сложный пароль, например: sD8f_2kL_9xP
WEBHOOK_SECRET=moy_secret_123

# Тип торговли: spot или swap (фьючерсы)
GATE_MARKET_TYPE=spot

# Порт для бота
PORT=5000
